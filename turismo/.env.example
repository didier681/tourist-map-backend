# Entorno de ejecución; production ejecuta migraciones y prohíbe synchronize.
NODE_ENV=development
# Puerto HTTP en el que escucha NestJS.
PORT=3000

# Credenciales de MySQL o MariaDB; DB_PASSWORD puede quedar vacío si el servidor lo permite.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=usuario
DB_PASSWORD=password-de-ejemplo
DB_DATABASE=turismo
# Solo se habilita sincronización fuera de producción; se recomienda false y usar migraciones.
DB_SYNCHRONIZE=false

# Secreto aleatorio de al menos 32 caracteres y duración del token.
JWT_SECRET=ejemplo-cambiar-por-un-secreto-aleatorio-de-32-caracteres
# Los tokens de acceso son breves; un secreto independiente protege la rotación de sesiones.
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=otro-secreto-aleatorio-diferente-de-al-menos-32-caracteres
JWT_REFRESH_EXPIRATION=7d

# Versión registrada al aceptar los términos y condiciones.
TERMS_VERSION=1.0

# URL pública del frontend que recibe el enlace de recuperación.
FRONTEND_URL=http://localhost:3000
# SMTP es opcional; reemplaza estos ejemplos y configúralos todos juntos para enviar correos.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario-ejemplo
SMTP_PASS=contrasena-smtp-de-ejemplo
MAIL_FROM=no-reply@ejemplo.com

# Orígenes web separados por comas; si queda vacío, desarrollo permite localhost.
CORS_ORIGINS=
# Publica Swagger únicamente cuando se habilita explícitamente.
SWAGGER_ENABLED=true

# Credenciales opcionales usadas por `npm run seed`; la contraseña debe cumplir la política.
ADMIN_EMAIL=admin@cordobacerca.local
ADMIN_PASSWORD=CambiarEstaClave123
ADMIN_NOMBRE=Administrador
